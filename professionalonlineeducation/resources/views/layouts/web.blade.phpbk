    <div class="cart_block">
        <a href="{{ route('addToCartPage') }}"><i class="fa fa-shopping-cart" aria-hidden="true"></i> <span id="cartCount">{{ Helper::getCartCount() }}</span></a>
    </div>
    <div class="chatBtn_block" id="chatBtn_block">
        <i class="fa fa-comments" aria-hidden="true"></i>
    </div>

    <style>
        .chatBtn_block:hover {
            opacity: 1;
        }
        .chatBtn_block {
            opacity: 0.8;
            position: fixed;
            right: 1em;
            bottom: 1em;
            width: 60px;
            height: 60px;
            background: #6ba546;
            border-radius: 50%;
            text-align: center;
            line-height: 59px;
            font-size: 24px;
            color: #fff;
            cursor: pointer;
        }
    </style>

    <div id="chat">
        <div id="hideChat">X</div>
        <div class="chathead">
            <img src="{{ url('webAssets/images/bot.png') }}" alt="" />
            <h4>Hello,</h4>
            <p>Welcome to our chat!</p>
        </div>
        <div class="container" id="flowchat"></div>
    </div>
    <link rel="stylesheet" href="{{ url('webAssets/js/conversational-flow-chat/src/flowchat.css') }}">

    <script src="{{ url('webAssets/js/conversational-flow-chat/src/flowchat.js') }}"></script>
    <script>

        $(function() {

            // Also try "demo-data/simple-data.json"

            $.getJSON( "{{ url('webAssets/js/conversational-flow-chat/demo-data/rosiland-data.json') }}", function( dataJSON ) {
                $('#flowchat').flowchat({
                    dataJSON: dataJSON,
                    autoStart: true
                });
            });

            $("#hideChat").click(function (){
                $("#chat").css('display','none');
                $("#chat").removeClass('active');
            });
            $("#chatBtn_block, .chat").click(function (){
                $("#chat").addClass('active');
                $("#chat").css('display','block');
            });

			$('.fa.fa-bars').click(function(){
				$('.navbar-nav.navbar').slideToggle();
			});
        });



    </script>





</body>
</html>
