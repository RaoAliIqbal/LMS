APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_WEB_FILE=true
LOG_WEB_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@professionalonlineeducation.com
MAIL_FROM_NAME="${APP_NAME}"
# Production: set MAIL_FROM_ADDRESS to the same mailbox as MAIL_USERNAME when your host requires it.
# Chatbot defaults to using MAIL_USERNAME as envelope From when it is a valid email (CHATBOT_FORCE_SMTP_ENVELOPE_FROM default true).

# Optional: full URL to your Google Business review page. If empty, the “Leave a Review” widget is hidden.
GOOGLE_REVIEW_URL=

# Chatbot mail: default true = envelope From matches MAIL_USERNAME when that value is a valid email (recommended for cPanel / same as typical local SMTP).
# Set to false only if your SMTP provider needs a different From than the login (e.g. some API usernames).
CHATBOT_FORCE_SMTP_ENVELOPE_FROM=true

# Website chatbot — staff notifications go to CHATBOT_MANAGER_EMAIL (default: mgr@…)
CHATBOT_MANAGER_EMAIL=mgr@professionalonlineeducation.com
# Leave false on production unless your SMTP allows a different envelope From than MAIL_FROM_ADDRESS.
CHATBOT_USE_CUSTOM_FROM=false
CHATBOT_FROM_EMAIL=
CHATBOT_FROM_NAME="Support Bot Escalations"
CHATBOT_STUDENT_FROM_NAME="CCI Support Team"
CHATBOT_SUPPORT_EMAIL=mgr@professionalonlineeducation.com
# Only used if CHATBOT_MANAGER_EMAIL is empty:
CHATBOT_IT_EMAIL=
CHATBOT_INSTRUCTOR_EMAIL=
CHATBOT_CUSTOMER_SERVICE_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
